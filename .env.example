# Copy to .env at the repo root (docker-compose reads it; the API loads it via dotenv)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas?schema=public
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
WEB_URL=http://localhost:5173
PORT=4000

# Stripe — optional in dev; billing endpoints return 503 until configured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
